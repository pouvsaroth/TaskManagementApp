<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom layer is the border color -->
    <item>
        <shape>
            <solid android:color="@color/popup_border" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
    <!-- Top layer is the background color, shifted down by 1.5dp to show only top border -->
    <item
        android:top="1.5dp"
        android:left="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape>
            <solid android:color="@color/nav_background" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
